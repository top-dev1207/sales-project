{
    "name": "@crm/rest",
    "version": "1.1.0",
    "description": "CRM REST",
    "keywords": [
        "admin",
        "admin panel",
        "bootstrap",
        "css",
        "dashboard",
        "framework",
        "front-end",
        "responsive",
        "sass",
        "webapp",
        "laravel"
    ],
    "license": "MIT",
    "author": {
        "name": "Mauricio Lucero"
    },
    "main": "public/index.php",
    "scripts": {
        "build": "npm-run-all build-clean build-copy build-vendors",
        "build-clean": "rimraf dist",
        "build-copy": "copyfiles -a -e \"public/scss/**/*\" -u 1 \"public/**/*\" dist/",
        "build-vendors": "node build/vendors.js",
        "css": "npm-run-all --parallel css-compile* --sequential css-prefix css-minify*",
        "css-compile": "node-sass --output-style expanded --source-map true --source-map-contents true --precision 6 public/scss/style.scss public/css/style.css",
        "css-compile-vendors": "node build/vendors-sass.js",
        "css-lint": "stylelint --config build/.stylelintrc --syntax scss \"public/scss/**/*.scss\"",
        "css-minify": "cleancss --level 1 --source-map --source-map-inline-sources --output public/css/style.min.css public/css/style.css",
        "css-prefix": "postcss --config build/postcss.config.js --replace \"public/css/*.css\" \"!public/css/*.min.css\"",
        "js": "npm-run-all --parallel js-compile* js-lint*",
        "js-compile": "cross-env PLUGINS=true babel public/js/src/ --out-dir public/js/ --source-maps",
        "js-lint": "eslint public/js/src",
        "localhost": "browser-sync start --server \"./public\" --serveStatic \"./\" --files \"!./public/js/src/**/*, ./public/**/*, !./public/scss/**/*\"",
        "localhost-dist": "browser-sync start --server \"./dist\"",
        "pug": "node build/pug.js",
        "release-version": "node build/change-version.js",
        "serve": "npm-run-all --parallel localhost watch-css watch-js",
        "watch-css": "nodemon --ignore dist/ -e scss -x \"npm run css\"",
        "watch-js": "nodemon --watch public/js/src/ -x \"npm run js\"",
        "watch-pug": "nodemon -e pug -x \"npm run pug\"",
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix wach -- --watch-options-poll=1000",
        "hot": "mix wacht --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "postinstall": "npm run prod"
    },
    "dependencies": {
        "@coreui/chartjs": "^3.1.2",
        "@coreui/coreui": "^3.2.0",
        "@coreui/icons": "^3.0.1",
        "@coreui/utils": "^2.0.2",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@popperjs/core": "^2.11.8",
        "animate.css": "^4.1.1",
        "autonumeric": "^4.10.7",
        "axios": "^1.6.1",
        "bootstrap": "^5.3.2",
        "chart.js": "^4.4.0",
        "chartjs-plugin-datalabels": "^2.2.0",
        "cropperjs": "^1.6.1",
        "jquery": "^3.7.1",
        "jquery-mask-plugin": "^1.14.16",
        "laravel-mix": "^6.0.49",
        "moment": "^2.30.1",
        "perfect-scrollbar": "1.5.5",
        "popper.js": "^1.16.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "vue": "^3.3.8"
    },
    "devDependencies": {
        "@babel/cli": "^7.23.0",
        "@babel/core": "^7.23.3",
        "@babel/plugin-proposal-object-rest-spread": "^7.12.1",
        "@babel/preset-env": "^7.23.3",
        "@babel/preset-react": "^7.27.1",
        "@coreui/svg-injector": "^1.0.0",
        "@coreui/vendors-injector": "^1.1.4",
        "@tailwindcss/forms": "^0.5.7",
        "@types/react": "^19.1.3",
        "@types/react-dom": "^19.1.3",
        "alpinejs": "^3.13.2",
        "autoprefixer": "^10.4.16",
        "babel-eslint": "^10.1.0",
        "babel-loader": "^10.0.0",
        "babel-plugin-transform-es2015-modules-strip": "^0.1.2",
        "browser-sync": "^2.23.7",
        "chalk": "^5.3.0",
        "clean-css-cli": "^5.6.2",
        "copyfiles": "^2.4.1",
        "cross-env": "^7.0.3",
        "eslint": "^8.53.0",
        "eslint-config-xo": "^0.43.1",
        "eslint-plugin-import": "^2.29.0",
        "eslint-plugin-unicorn": "^49.0.0",
        "foreach-cli": "^1.8.1",
        "js-beautify": "^1.14.11",
        "jsdom": "^22.1.0",
        "minimist": "^1.2.8",
        "node-notifier": "^10.0.1",
        "nodemon": "^3.0.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.31",
        "postcss-cli": "^10.1.0",
        "postcss-combine-duplicated-selectors": "^10.0.3",
        "postcss-import": "^15.1.0",
        "postcss-merge-rules": "^6.0.1",
        "pug": "^3.0.2",
        "resolve-url-loader": "^5.0.0",
        "rimraf": "^5.0.5",
        "sass": "^1.69.5",
        "sass-loader": "^13.3.2",
        "shelljs": "^0.8.5",
        "stylelint": "^15.11.0",
        "stylelint-config-recommended-scss": "^13.1.0",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-order": "^6.0.3",
        "stylelint-scss": "^5.3.1",
        "sync-glob": "^1.4.0",
        "tailwindcss": "^3.3.5",
        "ts-loader": "^9.5.2",
        "typescript": "^5.8.3",
        "vue-loader": "^17.3.1",
        "vue-template-compiler": "^2.7.15"
    },
    "engines": {
        "node": ">=8"
    },
    "browserslist": [
        "last 1 major version",
        ">= 1%",
        "Chrome >= 45",
        "Firefox >= 38",
        "Edge >= 12",
        "Explorer >= 10",
        "iOS >= 9",
        "Safari >= 9",
        "Android >= 4.4",
        "Opera >= 30"
    ]
}
